## ex5.D.code — Three-dimensional surface plot

```python
import os
import tempfile
from pathlib import Path

os.environ.setdefault("MPLCONFIGDIR", str(Path(tempfile.gettempdir()) / "fds-lab-matplotlib"))
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

results = Path("results")
results.mkdir(parents=True, exist_ok=True)
import numpy as np

x = np.linspace(-5, 5, 100)
y = np.linspace(-5, 5, 100)
x_grid, y_grid = np.meshgrid(x, y)
z_grid = np.sin(np.sqrt(x_grid**2 + y_grid**2))
figure = plt.figure(figsize=(8, 6))
axis = figure.add_subplot(111, projection="3d")
surface = axis.plot_surface(x_grid, y_grid, z_grid, cmap="viridis", edgecolor="none")
axis.set(title="3D Surface Plot", xlabel="X Axis", ylabel="Y Axis", zlabel="Z Axis")
figure.colorbar(surface, ax=axis, shrink=0.6, aspect=12)
figure.tight_layout()
figure.savefig(results / "ex5_D_3d_surface.png", dpi=150)
plt.close(figure)
print("Saved results/ex5_D_3d_surface.png")
```

