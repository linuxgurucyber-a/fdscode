# Exercise 2: NumPy array operations

## ex2.code — Complete program (numbered sections 1-7)

```python
"""Create NumPy arrays and demonstrate common array operations."""

import numpy as np


def main():
    print("1. Create arrays")
    a = np.array([1, 2, 3])
    b = np.array([[4, 5, 6], [7, 8, 9]])
    print("a =", a)
    print("b =\n", b)

    print("\n2. Arrays with specific values")
    zeros = np.zeros((2, 3))
    ones = np.ones((2, 3))
    arange = np.arange(0, 10, 2)
    linspace = np.linspace(0, 1, 5)
    print("Zeros:\n", zeros)
    print("Ones:\n", ones)
    print("Arange:", arange)
    print("Linspace:", linspace)

    print("\n3. Element-wise arithmetic")
    x = np.array([1, 2, 3])
    y = np.array([4, 5, 6])
    print("Addition:", x + y)
    print("Subtraction:", x - y)
    print("Multiplication:", x * y)
    print("Division:", y / x)
    print("Power:", x**2)
    print("Negative:", -x)
    print("Square root:", np.sqrt(x))

    print("\n4. Aggregation functions")
    data = np.array([[1, 2], [3, 4]])
    print("Data:\n", data)
    print("Total sum:", np.sum(data))
    print("Mean:", np.mean(data))
    print("Maximum:", np.max(data))
    print("Row sums:", np.sum(data, axis=1))
    print("Column maxima:", np.max(data, axis=0))

    print("\n5. Boolean masks and logical operations")
    values = np.array([1, 2, 3, 4, 5])
    mask = values > 3
    print("Mask (values > 3):", mask)
    print("Filtered values:", values[mask])
    left = np.array([1, 2, 6, 4, 9])
    right = np.array([2, 3, 4, 5, 8])
    condition = (left < right) & (left > 2)
    print("Condition (left < right) and (left > 2):", condition)

    print("\n6. Broadcasting")
    column = np.array([[1], [2], [3]])
    row = np.array([10, 20, 30])
    print("Column shape:", column.shape)
    print("Row shape:", row.shape)
    print("Broadcast product:\n", column * row)

    print("\n7. Scalar addition")
    matrix = np.array([[1, 2], [3, 4]])
    print("Matrix plus 10:\n", matrix + 10)


if __name__ == "__main__":
    main()
```

## ex2.installs

```bash
python -m pip install numpy
```

