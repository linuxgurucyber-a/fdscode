# Exercise 8: Z-scores and normal distribution

## ex8.code — Complete program

```python
"""Calculate z-scores and plot a sample with its normal density curve."""

import math
import os
import random
import statistics
import tempfile
from pathlib import Path

os.environ.setdefault("MPLCONFIGDIR", str(Path(tempfile.gettempdir()) / "fds-lab-matplotlib"))

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt


RESULTS = Path("results")


def main():
    generator = random.Random(42)
    data = [generator.gauss(50, 10) for _ in range(100)]
    mean = statistics.mean(data)
    standard_deviation = statistics.pstdev(data)
    if standard_deviation == 0:
        raise ValueError("The data must contain more than one distinct value.")

    z_scores = [(value - mean) / standard_deviation for value in data]
    print("First 10 values:", [round(value, 3) for value in data[:10]])
    print("Mean:", round(mean, 3))
    print("Population standard deviation:", round(standard_deviation, 3))
    print("First 10 z-scores:", [round(value, 3) for value in z_scores[:10]])

    x_min = min(data)
    x_max = max(data)
    x_values = [x_min + index * (x_max - x_min) / 199 for index in range(200)]
    density = [
        math.exp(-0.5 * ((value - mean) / standard_deviation) ** 2)
        / (standard_deviation * math.sqrt(2 * math.pi))
        for value in x_values
    ]

    RESULTS.mkdir(parents=True, exist_ok=True)
    figure, axis = plt.subplots(figsize=(8, 5))
    axis.hist(data, bins=15, density=True, alpha=0.6, color="skyblue", edgecolor="black")
    axis.plot(x_values, density, color="red", linewidth=2, label="Normal density")
    axis.set(title="Normal Distribution with Z-Scores", xlabel="Value", ylabel="Density")
    axis.legend()
    figure.tight_layout()
    output_path = RESULTS / "ex8_z_scores.png"
    figure.savefig(output_path, dpi=150)
    plt.close(figure)
    print("Plot saved to:", output_path)


if __name__ == "__main__":
    main()
```

