# Exercise 9: Correlation coefficients and scatter plots

## ex9.code — Complete program

```python
"""Compute pairwise correlations and save a heatmap with scatter plots."""

import os
import random
import tempfile
from pathlib import Path

os.environ.setdefault("MPLCONFIGDIR", str(Path(tempfile.gettempdir()) / "fds-lab-matplotlib"))

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt


RESULTS = Path("results")


def pearson(left, right):
    left_mean = sum(left) / len(left)
    right_mean = sum(right) / len(right)
    numerator = sum((x - left_mean) * (y - right_mean) for x, y in zip(left, right))
    left_sum = sum((x - left_mean) ** 2 for x in left)
    right_sum = sum((y - right_mean) ** 2 for y in right)
    denominator = (left_sum * right_sum) ** 0.5
    if denominator == 0:
        raise ValueError("Correlation is undefined for a constant column.")
    return numerator / denominator


def main():
    generator = random.Random(42)
    data = {
        "X": [generator.randint(1, 100) for _ in range(50)],
        "Y": [generator.randint(1, 100) for _ in range(50)],
        "Z": [generator.randint(1, 100) for _ in range(50)],
    }
    names = list(data)
    matrix = [[pearson(data[left], data[right]) for right in names] for left in names]

    print("Correlation coefficients:")
    print("      " + "  ".join("{:>8}".format(name) for name in names))
    for name, row in zip(names, matrix):
        print("{:>5} ".format(name) + "  ".join("{:8.4f}".format(value) for value in row))

    RESULTS.mkdir(parents=True, exist_ok=True)
    figure, axes = plt.subplots(2, 2, figsize=(10, 8))
    heatmap = axes[0, 0].imshow(matrix, vmin=-1, vmax=1, cmap="coolwarm")
    axes[0, 0].set(title="Correlation Coefficient Heatmap", xticks=range(3), yticks=range(3))
    axes[0, 0].set_xticklabels(names)
    axes[0, 0].set_yticklabels(names)
    for row in range(3):
        for column in range(3):
            axes[0, 0].text(column, row, "{:.2f}".format(matrix[row][column]), ha="center", va="center")
    figure.colorbar(heatmap, ax=axes[0, 0], fraction=0.046)

    for axis, (x_name, y_name), color in zip(
        [axes[0, 1], axes[1, 0], axes[1, 1]],
        [("X", "Y"), ("X", "Z"), ("Y", "Z")],
        ["blue", "green", "darkorange"],
    ):
        axis.scatter(data[x_name], data[y_name], color=color, alpha=0.8)
        axis.set(xlabel=x_name, ylabel=y_name, title="{} versus {}".format(x_name, y_name))

    figure.tight_layout()
    output_path = RESULTS / "ex9_correlations.png"
    figure.savefig(output_path, dpi=150)
    plt.close(figure)
    print("Plots saved to:", output_path)


if __name__ == "__main__":
    main()
```

