## ex4.B.code — Read an Excel workbook

```python
import tempfile
from pathlib import Path
from openpyxl import Workbook, load_workbook

with tempfile.TemporaryDirectory() as temp_dir:
    workbook_path = Path(temp_dir) / "Sample.xlsx"
    workbook = Workbook()
    sheet = workbook.active
    sheet.title = "Sample"
    sheet.append(["Name", "Score"])
    sheet.append(["Asha", 92])
    sheet.append(["Ravi", 87])
    workbook.save(workbook_path)
    loaded = load_workbook(workbook_path, read_only=True, data_only=True)
    for row in loaded["Sample"].iter_rows(values_only=True):
        print(row)
    loaded.close()
```

## ex4.C.code — Read a webpage title

```python
import certifi
import ssl
import urllib.error
import urllib.request
from html.parser import HTMLParser

class TitleParser(HTMLParser):
    def __init__(self):
        HTMLParser.__init__(self)
        self.in_title = False
        self.title_parts = []

    def handle_starttag(self, tag, attrs):
        if tag.lower() == "title":
            self.in_title = True

    def handle_endtag(self, tag):
        if tag.lower() == "title":
            self.in_title = False

    def handle_data(self, data):
        if self.in_title:
            self.title_parts.append(data.strip())

def read_webpage():
    print("\n4.C - Read a webpage title")
    request = urllib.request.Request(
        "https://example.com/",
        headers={"User-Agent": "FDS-Lab-Student/1.0"},
    )
    try:
        with urllib.request.urlopen(
            request, timeout=10, context=ssl.create_default_context(cafile=certifi.where())
        ) as response:
            parser = TitleParser()
            parser.feed(response.read().decode("utf-8", errors="replace"))
        print("Page title:", "".join(parser.title_parts) or "(no title found)")
    except (urllib.error.URLError, TimeoutError, OSError) as error:
        print("Webpage could not be reached; this section needs an internet connection.")
        print("Details:", error)

read_webpage()
```

## ex4.D.code — Descriptive analysis of the Iris dataset

```python
import os
import statistics
import tempfile
from collections import Counter
from pathlib import Path

os.environ.setdefault("MPLCONFIGDIR", str(Path(tempfile.gettempdir()) / "fds-lab-matplotlib"))
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris

RESULTS = Path("results")
def percentile(values, fraction):
    ordered = sorted(values)
    position = (len(ordered) - 1) * fraction
    lower = int(position)
    upper = min(lower + 1, len(ordered) - 1)
    weight = position - lower
    return ordered[lower] * (1 - weight) + ordered[upper] * weight

def pearson(left, right):
    left_mean = sum(left) / len(left)
    right_mean = sum(right) / len(right)
    numerator = sum((x - left_mean) * (y - right_mean) for x, y in zip(left, right))
    denominator = (
        sum((x - left_mean) ** 2 for x in left)
        * sum((y - right_mean) ** 2 for y in right)
    ) ** 0.5
    if denominator == 0:
        raise ValueError("Correlation is undefined for a constant feature.")
    return numerator / denominator

def iris_analysis():
    print("\n4.D - Descriptive analysis of the Iris dataset")
    iris = load_iris()
    rows = iris.data.tolist()
    labels = iris.target.tolist()
    names = iris.feature_names
    print("Rows:", len(rows), "Columns:", len(names))
    print("Features:", names)
    print("Species counts:", dict(Counter(iris.target_names[index] for index in labels)))

    for column, name in enumerate(names):
        values = [row[column] for row in rows]
        print(
            "{}: mean={:.3f}, median={:.3f}, std={:.3f}, variance={:.3f}".format(
                name,
                statistics.mean(values),
                statistics.median(values),
                statistics.stdev(values),
                statistics.variance(values),
            )
        )

    print("Pearson correlation matrix:")
    columns = [[row[column] for row in rows] for column in range(len(names))]
    for left in columns:
        print([round(pearson(left, right), 3) for right in columns])

    sepal_width = [row[1] for row in rows]
    q1 = percentile(sepal_width, 0.25)
    q3 = percentile(sepal_width, 0.75)
    iqr = q3 - q1
    low, high = q1 - 1.5 * iqr, q3 + 1.5 * iqr
    kept = [row for row in rows if low <= row[1] <= high]
    print("Shape before outlier filtering: ({}, {})".format(len(rows), len(names)))
    print("Shape after filtering Sepal Width outliers: ({}, {})".format(len(kept), len(names)))

    RESULTS.mkdir(parents=True, exist_ok=True)
    colors = ["tab:blue", "tab:orange", "tab:green"]
    figure, axes = plt.subplots(1, 3, figsize=(15, 4.5))
    for species_id, species_name in enumerate(iris.target_names):
        species_rows = [row for row, label in zip(rows, labels) if label == species_id]
        axes[0].scatter(
            [row[0] for row in species_rows],
            [row[1] for row in species_rows],
            label=species_name,
            color=colors[species_id],
            s=18,
        )
        axes[1].scatter(
            [row[2] for row in species_rows],
            [row[3] for row in species_rows],
            label=species_name,
            color=colors[species_id],
            s=18,
        )
    axes[0].set(title="Sepal measurements", xlabel="Sepal length (cm)", ylabel="Sepal width (cm)")
    axes[1].set(title="Petal measurements", xlabel="Petal length (cm)", ylabel="Petal width (cm)")
    axes[0].legend(fontsize="small")
    axes[1].legend(fontsize="small")
    axes[2].boxplot([sepal_width, [row[1] for row in kept]])
    axes[2].set_xticks([1, 2])
    axes[2].set_xticklabels(["All", "Filtered"])
    axes[2].set(title="Sepal width outliers", ylabel="Sepal width (cm)")
    figure.tight_layout()
    output_path = RESULTS / "ex4_iris_analysis.png"
    figure.savefig(output_path, dpi=150)
    plt.close(figure)
    print("Plot saved to:", output_path)

iris_analysis()
```

