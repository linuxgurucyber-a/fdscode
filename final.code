# Exercise 6: Geographic visualization with Basemap

## ex6.code — Complete program

```python
"""Draw an India-centered map and mark several cities with Basemap."""

import os
import tempfile
from pathlib import Path

os.environ.setdefault("MPLCONFIGDIR", str(Path(tempfile.gettempdir()) / "fds-lab-matplotlib"))

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
from mpl_toolkits.basemap import Basemap


RESULTS = Path("results")


def main():
    RESULTS.mkdir(parents=True, exist_ok=True)
    cities = {
        "Delhi": (77.2090, 28.6139),
        "Mumbai": (72.8777, 19.0760),
        "Kolkata": (88.3639, 22.5726),
        "Chennai": (80.2707, 13.0827),
        "Bengaluru": (77.5946, 12.9716),
    }

    figure, axis = plt.subplots(figsize=(9, 8))
    map_view = Basemap(
        projection="merc",
        llcrnrlon=66,
        urcrnrlon=99,
        llcrnrlat=5,
        urcrnrlat=39,
        resolution="c",
        ax=axis,
    )
    map_view.drawmapboundary(fill_color="#dcebf7")
    map_view.fillcontinents(color="#eef5e9", lake_color="#dcebf7")
    map_view.drawcoastlines(color="#4b5563", linewidth=0.7)
    map_view.drawcountries(color="#4b5563", linewidth=0.5)
    map_view.drawparallels(range(5, 40, 5), labels=[1, 0, 0, 0], linewidth=0.2, fontsize=7)
    map_view.drawmeridians(range(65, 100, 5), labels=[0, 0, 0, 1], linewidth=0.2, fontsize=7)

    for city, (longitude, latitude) in cities.items():
        x, y = map_view(longitude, latitude)
        map_view.scatter(x, y, s=35, color="crimson", edgecolor="white", linewidth=0.6, zorder=5)
        axis.annotate(city, (x, y), xytext=(5, 4), textcoords="offset points", fontsize=8)

    axis.set_title("Selected Cities in India")
    figure.tight_layout()
    output_path = RESULTS / "ex6_india_map.png"
    figure.savefig(output_path, dpi=160)
    plt.close(figure)
    print("Map saved to:", output_path)


if __name__ == "__main__":
    main()
```

## ex6.installs

```bash
python -m pip install numpy matplotlib basemap
```

This version uses Basemap’s built-in boundaries and needs no downloaded shapefiles.

# Exercise 7: Diabetes data analysis and regression

## ex7.A.code — Univariate analysis of the diabetes dataset

```python
import os
import tempfile
from pathlib import Path

os.environ.setdefault("MPLCONFIGDIR", str(Path(tempfile.gettempdir()) / "fds-lab-matplotlib"))
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import pandas as pd
from sklearn.datasets import load_diabetes

RESULTS = Path("results")
def diabetes_frame():
    dataset = load_diabetes()
    return pd.DataFrame(dataset.data, columns=dataset.feature_names), pd.Series(dataset.target, name="target")

def univariate_analysis():
    print("7.A - Univariate analysis")
    features, target = diabetes_frame()
    frame = features.copy()
    frame["target"] = target
    print("Shape:", frame.shape)
    print("Data summary:\n", frame.describe().round(3))
    print("Mean:\n", frame.mean().round(3))
    print("Median:\n", frame.median().round(3))
    print("Mode:\n", frame.mode().iloc[0].round(3))
    print("Standard deviation:\n", frame.std().round(3))
    print("Variance:\n", frame.var().round(3))
    print("Skewness:\n", frame.skew().round(3))
    print("Kurtosis:\n", frame.kurtosis().round(3))

    RESULTS.mkdir(parents=True, exist_ok=True)
    axes = frame.drop(columns=["target"]).hist(bins=30, figsize=(12, 10))
    axes.ravel()[0].figure.suptitle("Diabetes Dataset Feature Histograms")
    axes.ravel()[0].figure.tight_layout()
    path = RESULTS / "ex7_univariate_histograms.png"
    axes.ravel()[0].figure.savefig(path, dpi=140)
    plt.close(axes.ravel()[0].figure)
    print("Histogram saved to:", path)

univariate_analysis()
```

## ex7.B.code — Bivariate linear regression

```python
import numpy as np
import pandas as pd
from sklearn.datasets import load_diabetes
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.model_selection import cross_val_score, train_test_split

def diabetes_frame():
    dataset = load_diabetes()
    return pd.DataFrame(dataset.data, columns=dataset.feature_names), pd.Series(dataset.target, name="target")

def linear_regression_analysis(features, target):
    print("\n7.B - Linear regression on the diabetes dataset")
    x_train, x_test, y_train, y_test = train_test_split(
        features, target, test_size=0.30, random_state=101
    )
    model = LinearRegression().fit(x_train, y_train)
    predicted = model.predict(x_test)
    cv_mse = cross_val_score(
        LinearRegression(), features, target, scoring="neg_mean_squared_error", cv=10
    )
    print("10-fold cross-validation RMSE:", round(float(np.sqrt(-cv_mse).mean()), 3))
    print("Test R^2:", round(float(r2_score(y_test, predicted)), 3))
    print("Test RMSE:", round(float(np.sqrt(mean_squared_error(y_test, predicted))), 3))
    print("Weights:", np.round(model.coef_, 3))
    print("Intercept:", round(float(model.intercept_), 3))

features, target = diabetes_frame()
linear_regression_analysis(features, target)
```

## ex7.C.code — Bivariate logistic regression

```python
import os
import tempfile
from pathlib import Path

os.environ.setdefault("MPLCONFIGDIR", str(Path(tempfile.gettempdir()) / "fds-lab-matplotlib"))
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.datasets import load_diabetes
from sklearn.metrics import accuracy_score, confusion_matrix
from sklearn.model_selection import train_test_split
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression

RESULTS = Path("results")
def diabetes_frame():
    dataset = load_diabetes()
    return pd.DataFrame(dataset.data, columns=dataset.feature_names), pd.Series(dataset.target, name="target")

def logistic_regression_analysis(features, target):
    print("\n7.C - Logistic regression on a binary diabetes target")
    binary_target = (target >= target.median()).astype(int)
    x_train, x_test, y_train, y_test = train_test_split(
        features,
        binary_target,
        test_size=0.30,
        random_state=101,
        stratify=binary_target,
    )
    model = make_pipeline(StandardScaler(), LogisticRegression(max_iter=2000, random_state=101))
    model.fit(x_train, y_train)
    predicted = model.predict(x_test)
    matrix = confusion_matrix(y_test, predicted)
    print("Accuracy:", round(float(accuracy_score(y_test, predicted)), 3))
    print("Confusion matrix:\n", matrix)

    RESULTS.mkdir(parents=True, exist_ok=True)
    figure, axis = plt.subplots(figsize=(5, 4))
    image = axis.imshow(matrix, cmap="Blues")
    for row in range(matrix.shape[0]):
        for column in range(matrix.shape[1]):
            axis.text(column, row, str(matrix[row, column]), ha="center", va="center")
    axis.set(xticks=[0, 1], yticks=[0, 1], xlabel="Predicted", ylabel="Actual", title="Confusion Matrix")
    figure.colorbar(image, ax=axis)
    figure.tight_layout()
    path = RESULTS / "ex7_logistic_confusion_matrix.png"
    figure.savefig(path, dpi=140)
    plt.close(figure)
    print("Confusion matrix plot saved to:", path)

features, target = diabetes_frame()
logistic_regression_analysis(features, target)
```

## ex7.D.code — Multiple regression with the Pima diabetes dataset

```python
from io import StringIO
from pathlib import Path
import urllib.request

import numpy as np
import pandas as pd
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

ROOT = Path(".")
PIMA_PATH = ROOT / "data" / "pima_diabetes.csv"
PIMA_URL = "https://raw.githubusercontent.com/jbrownlee/Datasets/master/pima-indians-diabetes.data.csv"
PIMA_COLUMNS = ["Pregnancies", "Glucose", "BloodPressure", "SkinThickness", "Insulin", "BMI", "DiabetesPedigreeFunction", "Age", "Outcome"]
def load_pima_data():
    if PIMA_PATH.is_file():
        print("Reading local data:", PIMA_PATH)
        frame = pd.read_csv(PIMA_PATH, header=None)
        if frame.shape[1] != len(PIMA_COLUMNS):
            raise ValueError("The local Pima CSV must have 9 columns.")
        if str(frame.iloc[0, 0]).strip().lower() == "pregnancies":
            frame = frame.iloc[1:].reset_index(drop=True)
        frame.columns = PIMA_COLUMNS
        return frame.apply(pd.to_numeric, errors="raise")

    print("Downloading the Pima CSV on first use (internet required)...")
    request = urllib.request.Request(PIMA_URL, headers={"User-Agent": "FDS-Lab-Student/1.0"})
    with urllib.request.urlopen(request, timeout=20) as response:
        content = response.read().decode("utf-8")
    PIMA_PATH.parent.mkdir(parents=True, exist_ok=True)
    PIMA_PATH.write_text(content, encoding="utf-8")
    frame = pd.read_csv(StringIO(content), header=None, names=PIMA_COLUMNS)
    if len(frame) != 768 or frame.shape[1] != 9:
        raise ValueError("The Pima CSV did not have the expected 768 rows and 9 columns.")
    return frame

def pima_multiple_regression():
    print("\n7.D - Multiple regression on the Pima diabetes dataset")
    try:
        frame = load_pima_data()
    except (OSError, ValueError) as error:
        print("Pima regression skipped because its CSV could not be loaded:", error)
        print("Place pima_diabetes.csv in the repository's data/ folder or connect to the internet.")
        return

    feature_names = ["Age", "Glucose", "BMI", "BloodPressure", "Pregnancies"]
    x = frame[feature_names]
    y = frame["Outcome"]
    x_train, x_test, y_train, y_test = train_test_split(
        x, y, test_size=0.30, random_state=101
    )
    model = LinearRegression().fit(x_train, y_train)
    predicted = model.predict(x_test)
    print("Coefficients:", np.round(model.coef_, 4))
    print("Intercept:", round(float(model.intercept_), 4))
    print("Variance score (R^2):", round(float(model.score(x_test, y_test)), 3))
    print("Test RMSE:", round(float(np.sqrt(mean_squared_error(y_test, predicted))), 3))

pima_multiple_regression()
```

