)
exam_marks = pd.DataFrame(
    {
        "student_id": [101, 102, 103, 105],
        "exam": ["FDS", "FDS", "FDS", "FDS"],
        "marks": [88, 76, 93, 80],
    }
)

merged = pd.merge(details, exam_marks, on="student_id", how="inner")
