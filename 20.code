# Experiment 14: Interactive plot that responds to a slider

## ex14.code

```python
"""Experiment 14: Interactive plot whose content responds to a slider."""
import os
import sys
from pathlib import Path

import matplotlib
import matplotlib.pyplot as plt
import numpy as np


def has_interactive_desktop():
    backend = matplotlib.get_backend().lower()
    gui_backend = any(name in backend for name in ("gtk", "macosx", "qt", "tk", "wx"))
    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    return gui_backend and (not sys.platform.startswith("linux") or has_display)


output_path = Path("results/ex14_interactive_slider.png")
output_path.parent.mkdir(parents=True, exist_ok=True)
x = np.linspace(0, 2 * np.pi, 300)
figure, axis = plt.subplots(figsize=(8, 5))
figure.subplots_adjust(bottom=0.25)
line, = axis.plot(x, np.sin(x), color="purple", label="sin(x)")
axis.set(title="Move the slider to change the wave", xlabel="x", ylabel="Amplitude")
axis.set_ylim(-3, 3)
axis.grid(True, alpha=0.3)
axis.legend()

if has_interactive_desktop():
    from matplotlib.widgets import Slider

    slider_axis = figure.add_axes([0.18, 0.08, 0.65, 0.04])
    amplitude_slider = Slider(slider_axis, "Amplitude", 0.1, 3.0, valinit=1.0)

    def update_plot(amplitude):
        line.set_ydata(amplitude * np.sin(x))
        figure.canvas.draw_idle()
        figure.savefig(output_path, dpi=150, bbox_inches="tight")

    amplitude_slider.on_changed(update_plot)
    figure.savefig(output_path, dpi=150, bbox_inches="tight")
    print(f"Saved initial plot to {output_path}. Move the slider to update the graph.")
    try:
        plt.show()
    except Exception as error:
        print(f"The interactive window could not open: {error}")
    plt.close(figure)
else:
    figure.savefig(output_path, dpi=150, bbox_inches="tight")
    print(
        f"Saved a static preview to {output_path}; the interactive slider needs "
        "a Linux graphical desktop and an interactive Matplotlib backend."
    )
    plt.close(figure)
```

## ex14.installs

```bash
python -m pip install matplotlib numpy

# Ubuntu/Debian graphical desktop: install Tk support once if plot windows do not open.
