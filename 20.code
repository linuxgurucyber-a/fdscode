# Experiment 7: Iris dataset from a URL: first ten records

## ex7.code

```python
"""Experiment 7: Read the first ten Iris records from a URL."""
import ssl
from io import BytesIO
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

import pandas as pd

IRIS_URL = "https://raw.githubusercontent.com/mwaskom/seaborn-data/master/iris.csv"
TIMEOUT_SECONDS = 20

try:
    request = Request(IRIS_URL, headers={"User-Agent": "FDS-Lab-Iris-Reader/1.0"})
    with urlopen(request, timeout=TIMEOUT_SECONDS) as response:
        csv_bytes = response.read()
    iris = pd.read_csv(BytesIO(csv_bytes))
    if iris.empty:
        raise ValueError("The URL returned an empty CSV file.")
except HTTPError as error:
    raise SystemExit(f"HTTP error {error.code} while reading {IRIS_URL}: {error.reason}") from error
except ssl.SSLCertVerificationError as error:
    raise SystemExit(f"HTTPS certificate verification failed for {IRIS_URL}: {error}") from error
except TimeoutError as error:
    raise SystemExit(f"Timed out after {TIMEOUT_SECONDS} seconds while reading {IRIS_URL}.") from error
except URLError as error:
    reason = error.reason
    if isinstance(reason, ssl.SSLCertVerificationError):
        message = f"HTTPS certificate verification failed: {reason}"
    elif isinstance(reason, TimeoutError):
        message = f"connection timed out after {TIMEOUT_SECONDS} seconds"
    else:
        message = f"network error: {reason}"
    raise SystemExit(f"Could not read {IRIS_URL} ({message}). Check the URL and internet connection.") from error
except (ValueError, pd.errors.ParserError) as error:
    raise SystemExit(f"Could not parse Iris CSV from {IRIS_URL}: {error}") from error

print("Iris data source:", IRIS_URL)
print("First 10 records:\n", iris.head(10).to_string(index=False))
```

## ex7.installs

```bash
python -m pip install pandas

# Internet is required to read the Iris CSV URL.
```

This program reads a live CSV from the internet using verified HTTPS. Change IRIS_URL near the top of the code to use another Iris CSV URL. It reports HTTP, certificate, timeout, and network errors clearly.

