# Experiment 1: NumPy arrays: arithmetic and aggregates

## ex1.code

```python
"""Experiment 1: NumPy arithmetic and aggregate functions."""
import numpy as np

first = np.array([10, 20, 30, 40])
second = np.array([1, 2, 3, 4])

print("First array:", first)
print("Second array:", second)
print("Addition:", first + second)
print("Subtraction:", first - second)
print("Multiplication:", first * second)
print("Division:", first / second)
print("Sum:", np.sum(first))
print("Mean:", np.mean(first))
print("Minimum:", np.min(first))
print("Maximum:", np.max(first))
```

