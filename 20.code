# Experiment 2: Pandas DataFrame: student indexing, slicing, and filtering

## ex2.code

```python
"""Experiment 2: Pandas DataFrame indexing, slicing, and filtering."""
import pandas as pd

students = pd.DataFrame(
    {
        "student_id": [101, 102, 103, 104, 105],
        "name": ["Asha", "Ben", "Charu", "Dev", "Eva"],
        "department": ["CSE", "ECE", "CSE", "ME", "ECE"],
        "marks": [88, 76, 93, 69, 84],
    }
)

print("Complete student table:\n", students)
print("\nName column:\n", students["name"])
print("\nFirst three rows and first three columns:\n", students.iloc[:3, :3])
print("\nStudent with ID 103:\n", students.loc[students["student_id"] == 103])
print("\nStudents scoring at least 80:\n", students.loc[students["marks"] >= 80])
print("\nCSE students scoring at least 80:\n", students.loc[
    (students["department"] == "CSE") & (students["marks"] >= 80)
])
```

