# Experiment 13: Monthly sales line chart and bar chart

## ex13.code

```python
"""Experiment 13: Monthly sales line chart and bar chart."""
import os
import sys
from pathlib import Path

import matplotlib
import matplotlib.pyplot as plt


def save_and_show(figure, output_path):
    output_path = Path(output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    figure.savefig(output_path, dpi=150, bbox_inches="tight")
    backend = matplotlib.get_backend().lower()
    gui_backend = any(name in backend for name in ("gtk", "macosx", "qt", "tk", "wx"))
    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    if not gui_backend or (sys.platform.startswith("linux") and not has_display):
        print(f"Saved {output_path}; no graphical desktop/backend is available to open a window.")
    else:
        try:
            plt.show()
        except Exception as error:
            print(f"Saved {output_path}, but the plot window could not open: {error}")
    plt.close(figure)


months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]
sales = [12000, 14500, 13200, 17800, 16500, 21000]

figure, axes = plt.subplots(1, 2, figsize=(12, 5))
axes[0].plot(months, sales, marker="o", color="navy", label="Sales")
axes[0].set(title="Monthly Sales — Line Chart", xlabel="Month", ylabel="Sales")
axes[0].grid(True, alpha=0.3)
axes[0].legend()
axes[1].bar(months, sales, color="cornflowerblue", label="Sales")
axes[1].set(title="Monthly Sales — Bar Chart", xlabel="Month", ylabel="Sales")
axes[1].legend()
figure.tight_layout()
save_and_show(figure, "results/ex13_monthly_sales.png")
```

