"""Experiment 11: Merge student details with exam marks on a common key."""
import pandas as pd

details = pd.DataFrame(
    {
        "student_id": [101, 102, 103, 104],
        "name": ["Asha", "Ben", "Charu", "Dev"],
        "department": ["CSE", "ECE", "CSE", "ME"],
