sudo apt-get install -y python3-tk
```

This program saves its image under results/. A visible graph window requires a Linux desktop session, an interactive Matplotlib backend, and Tk support (python3-tk on Ubuntu/Debian).

# Experiment 19: Map selected latitude/longitude locations

## ex19.code

```python
"""Experiment 19: Plot selected cities from latitude and longitude coordinates."""
import os
import sys
from pathlib import Path

import matplotlib
import matplotlib.pyplot as plt
from mpl_toolkits.basemap import Basemap


def save_and_show(figure, output_path):
    output_path = Path(output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    figure.savefig(output_path, dpi=150, bbox_inches="tight")
    backend = matplotlib.get_backend().lower()
    gui_backend = any(name in backend for name in ("gtk", "macosx", "qt", "tk", "wx"))
    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    if not gui_backend or (sys.platform.startswith("linux") and not has_display):
        print(f"Saved {output_path}; no graphical desktop/backend is available to open a window.")
    else:
        try:
            plt.show()
        except Exception as error:
            print(f"Saved {output_path}, but the plot window could not open: {error}")
    plt.close(figure)


locations = {
    "New Delhi": (28.6139, 77.2090),
    "Mumbai": (19.0760, 72.8777),
    "Bengaluru": (12.9716, 77.5946),
    "London": (51.5072, -0.1276),
    "New York": (40.7128, -74.0060),
    "Tokyo": (35.6762, 139.6503),
    "Sydney": (-33.8688, 151.2093),
}

figure, axis = plt.subplots(figsize=(12, 6))
world = Basemap(
    projection="cyl",
    llcrnrlon=-180,
    urcrnrlon=180,
    llcrnrlat=-60,
    urcrnrlat=85,
    resolution="c",
    ax=axis,
)
world.drawmapboundary(fill_color="lightblue")
world.fillcontinents(color="whitesmoke", lake_color="lightblue")
world.drawcoastlines(linewidth=0.6)
world.drawcountries(linewidth=0.4, color="gray")
for city, (latitude, longitude) in locations.items():
    x, y = world(longitude, latitude)
    axis.scatter(x, y, marker="o", color="crimson", s=28, zorder=5)
    axis.annotate(city, (x, y), xytext=(4, 4), textcoords="offset points", fontsize=8)
axis.set_title("Selected Locations from Latitude and Longitude")
save_and_show(figure, "results/ex19_selected_locations.png")
```

## ex19.installs

```bash
python -m pip install matplotlib basemap

# Ubuntu/Debian graphical desktop: install Tk support once if plot windows do not open.
sudo apt-get install -y python3-tk
```

This program saves its image under results/. A visible graph window requires a Linux desktop session, an interactive Matplotlib backend, and Tk support (python3-tk on Ubuntu/Debian).

# Experiment 20: Mean, median, mode, variance, and standard deviation

## ex20.code

```python
"""Experiment 20: Mean, median, mode, variance, and standard deviation."""
from statistics import mean, median, multimode, stdev, variance

values = [12, 15, 15, 18, 20, 22, 25, 15, 28, 30]

print("Dataset:", values)
print("Count:", len(values))
print("Mean:", mean(values))
print("Median:", median(values))
print("Mode(s):", multimode(values))
print("Sample variance:", variance(values))
print("Sample standard deviation:", stdev(values))
```

