# Experiment 16: Iris 3D scatter plot

## ex16.code

```python
"""Experiment 16: 3D scatter plot of three Iris measurements."""
import os
import sys
from pathlib import Path

import matplotlib
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris


def save_and_show(figure, output_path):
    output_path = Path(output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    figure.savefig(output_path, dpi=150, bbox_inches="tight")
    backend = matplotlib.get_backend().lower()
    gui_backend = any(name in backend for name in ("gtk", "macosx", "qt", "tk", "wx"))
    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    if not gui_backend or (sys.platform.startswith("linux") and not has_display):
        print(f"Saved {output_path}; no graphical desktop/backend is available to open a window.")
    else:
        try:
            plt.show()
        except Exception as error:
            print(f"Saved {output_path}, but the plot window could not open: {error}")
    plt.close(figure)


iris = load_iris()
measurements = iris.data
target = iris.target
figure = plt.figure(figsize=(9, 7))
axis = figure.add_subplot(111, projection="3d")
colors = ["tab:blue", "tab:orange", "tab:green"]

for class_id, species in enumerate(iris.target_names):
    selected = target == class_id
    axis.scatter(
        measurements[selected, 0],
        measurements[selected, 1],
        measurements[selected, 2],
        color=colors[class_id],
        label=species,
        s=35,
        alpha=0.8,
    )

axis.set_xlabel("Sepal length (cm)")
axis.set_ylabel("Sepal width (cm)")
axis.set_zlabel("Petal length (cm)")
axis.set_title("Iris Dataset: 3D Scatter Plot")
axis.legend(title="Species")
save_and_show(figure, "results/ex16_iris_3d_scatter.png")
```

