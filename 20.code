# Experiment 9: Student records grouped by department

## ex9.code

```python
"""Experiment 9: Group student records by department."""
import pandas as pd

students = pd.DataFrame(
    {
        "student": ["Asha", "Ben", "Charu", "Dev", "Eva", "Farhan"],
        "department": ["CSE", "ECE", "CSE", "ME", "ECE", "CSE"],
        "marks": [88, 76, 93, 69, 84, 81],
    }
)

summary = students.groupby("department").agg(
    student_count=("student", "count"),
    average_marks=("marks", "mean"),
    maximum_marks=("marks", "max"),
)
print("Student records:\n", students)
print("\nCount, average, and maximum marks by department:\n", summary.round(2))
```

