# Experiment 4: Pandas reshape: pivot, melt, stack, loc, and iloc

## ex4.code

```python
"""Experiment 4: Pandas pivot, melt, stack, loc, and iloc."""
import pandas as pd

scores = pd.DataFrame(
    {
        "student": ["Asha", "Asha", "Ben", "Ben", "Charu", "Charu"],
        "semester": [1, 2, 1, 2, 1, 2],
        "subject": ["Python", "Python", "Python", "Python", "Python", "Python"],
        "marks": [82, 91, 76, 84, 95, 89],
    }
)

wide = scores.pivot(index="student", columns="semester", values="marks")
print("Long-form records:\n", scores)
print("\nPivoted wide table:\n", wide)
print("\nSelect a row by label (loc):\n", wide.loc["Asha"])
print("\nSelect the first two rows by position (iloc):\n", wide.iloc[:2])
print("\nMelt back into long form:\n", wide.reset_index().melt(
    id_vars="student", var_name="semester", value_name="marks"
))
print("\nStack the semester columns into an index level:\n", wide.stack())
```

