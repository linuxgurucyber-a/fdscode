# Experiment 5: Iris text file: load and explore with Pandas

## ex5.code

```python
"""Experiment 5: Load Iris from a local text/CSV file and explore it."""
from pathlib import Path

import pandas as pd
from sklearn.datasets import load_iris

IRIS_FILE = Path("iris_data.txt")  # Change this to the path of your own CSV text file.

if not IRIS_FILE.exists():
    iris = load_iris(as_frame=True)
    demo = iris.data.copy()
    demo["species"] = [iris.target_names[index] for index in iris.target]
    demo.to_csv(IRIS_FILE, index=False)
    print(f"Created a sample Iris text file at: {IRIS_FILE.resolve()}")

data = pd.read_csv(IRIS_FILE)
print("\nFirst five rows:\n", data.head())
print("\nDataFrame information:")
data.info()
print("\nShape (rows, columns):", data.shape)
```

